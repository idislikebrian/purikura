# Coordinator deployment URL.
# For local dev this is not needed — defaults to http://localhost:3001.
# For Vercel (web demo), set this to your deployed coordinator.
# https:// is automatically converted to wss:// for the WebSocket connection.
# VITE_COORDINATOR_URL=https://purikura-coordinator.fly.dev

# Coordinator port (server-side only, not used by the UI)
# PORT=3001

# Set to 'false' to use production timers (welcome 25s, review 8s, manip 5min)
# Defaults to 'true' (demo mode on) if unset
# DEMO_MODE=false
